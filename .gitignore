# Node.js & npm/yarn specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json # Optional: if only yarn.lock or pnpm-lock.yaml is used
yarn.lock         # Optional: if only package-lock.json or pnpm-lock.yaml is used
pnpm-lock.yaml    # Optional: if only package-lock.json or yarn.lock is used

# Server-specific (Node.js/Express.js)
# Add any server-specific build outputs or logs if not covered above
