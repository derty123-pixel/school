logs/
*.log
*.log.[0-9]
*.log.[0-9][0-9]
*.log.[0-9][0-9][0-9]
*.log.[0-9][0-9][0-9][0-9]
*.log.gz
*.log.gz.[0-9]
*.log.gz.[0-9][0-9]
*.log.gz.[0-9][0-9][0-9]
*.log.gz.[0-9][0-9][0-9][0-9]

